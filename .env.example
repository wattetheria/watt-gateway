WATTETHERIA_GATEWAY_BIND=0.0.0.0:8080
WATTETHERIA_GATEWAY_DATABASE_URL=postgres://postgres:postgres@postgres:5432/wattetheria_gateway
WATTETHERIA_GATEWAY_NATS_URL=nats://nats:4222
WATTETHERIA_GATEWAY_REQUEST_TIMEOUT_SECS=10
WATTETHERIA_GATEWAY_REGISTRY_ADMIN_TOKEN=change-me
WATTETHERIA_GATEWAY_BOOTSTRAP_REGISTRY_URLS=
WATTETHERIA_GATEWAY_IDENTITY_ID=gw-docker-1
WATTETHERIA_GATEWAY_IDENTITY_DISPLAY_NAME=Docker Gateway
WATTETHERIA_GATEWAY_IDENTITY_BASE_URL=http://127.0.0.1:8080
WATTETHERIA_GATEWAY_IDENTITY_SIGNING_KEY=CwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCws=
WATTETHERIA_GATEWAY_IDENTITY_REGION=local-dev
WATTETHERIA_GATEWAY_IDENTITY_OPERATOR_ID=operator-docker
WATTETHERIA_GATEWAY_IDENTITY_ROLES=ingest,query,federation
WATTETHERIA_GATEWAY_IDENTITY_SUPPORTED_ENDPOINTS=/api/network/status,/api/peers,/api/hives,/api/hive-messages,/api/missions,/api/organizations,/api/leaderboard,/api/registry/gateways,/api/registry/bootstrap,/api/registry/discovery,/api/registry/self-manifest,/api/registry/self-register
WATTETHERIA_GATEWAY_IDENTITY_ALLOWS_PUBLIC_INGEST=true
WATTETHERIA_GATEWAY_HTTP_PORT=8080
WATTETHERIA_GATEWAY_POSTGRES_PORT=55434
WATTETHERIA_GATEWAY_NATS_CLIENT_PORT=4222
WATTETHERIA_GATEWAY_NATS_MONITOR_PORT=8222
POSTGRES_DB=wattetheria_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Required only by docker-compose.client-server.yml.
WATTSWARM_RABBITMQ_USERNAME=wattswarm
WATTSWARM_RABBITMQ_PASSWORD=change-this-rabbitmq-password
WATTSWARM_CS_COMMIT_HMAC_SECRET=change-this-commit-hmac-secret-at-least-32-bytes
WATTSWARM_CS_BIND_ADDR=0.0.0.0:8090
WATTSWARM_CS_DATABASE_URL=postgres://postgres:postgres@postgres:5432/wattswarm_message_gateway
WATTSWARM_CS_POSTGRES_DB=wattswarm_message_gateway
WATTSWARM_CS_MESSAGE_BUS=rabbitmq
WATTSWARM_CS_HTTP_PORT=8090
WATTSWARM_CS_RUST_LOG=wattetheria_message_gateway=info,axum=info
WATTSWARM_RABBITMQ_ENDPOINT=amqps://rabbitmq:5671/%2fwattswarm?cacertfile=/run/rabbitmq-tls/ca.crt
WATTSWARM_RABBITMQ_VHOST=/wattswarm
WATTSWARM_RABBITMQ_CLUSTER_QUEUE_LIMIT=1100
WATTSWARM_RABBITMQ_MANAGEMENT_PORT=15672
